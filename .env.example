# ---------- MT5 / XM ----------
# ใช้บัญชี DEMO ก่อนเสมอ
MT5_LOGIN=
MT5_PASSWORD=
# ชื่อ server ตามที่ XM ส่งมาในอีเมลเปิดบัญชี / หน้า login ของ MT5
MT5_SERVER=
# path ของ terminal64.exe (เว้นว่างได้ถ้ามี MT5 ติดตั้งตัวเดียว)
MT5_PATH=
# ชื่อ symbol ทองในบัญชีคุณ (XM อาจเป็น GOLD หรือมี suffix) ดูใน Market Watch
SYMBOL=GOLD
MAGIC=260512

# ---------- โหมด ----------
# advisory = วิเคราะห์ + order_check เท่านั้น ไม่ส่ง order จริง (ค่าเริ่มต้น)
# demo     = ส่ง order ได้ แต่เฉพาะบัญชี demo
# live     = ส่ง order บัญชีจริง (ต้องตั้ง ALLOW_REAL_ACCOUNT=true ด้วย)
MODE=advisory
ALLOW_REAL_ACCOUNT=false
# รอบการตัดสินใจของ agent (ทำงานทุกครั้งที่แท่งนี้ปิด)
DECISION_TIMEFRAME=M5

# ---------- Risk (โค้ดตายตัว agent แก้ไม่ได้) ----------
MAX_LOT=0.01
MAX_RISK_PER_TRADE_PCT=0.5
MAX_DAILY_LOSS_PCT=2
MAX_OPEN_POSITIONS=1
MAX_TRADES_PER_DAY=10
# spread GOLD บน XM demo วัดได้ ~55 pts (2026-11-23) ถ้าตั้งต่ำกว่านี้ทุก order จะถูกปฏิเสธ
MAX_SPREAD_POINTS=70
MIN_SL_POINTS=50
# M5 ATR14 ของ GOLD วัดได้ ~760 pts (2026-11-23) ความเสี่ยงต่อไม้ยังถูกคุมด้วย MAX_RISK_PER_TRADE_PCT
MAX_SL_POINTS=1200
MIN_REWARD_RISK=1.0
# block new entries against the higher-timeframe bias (M15, M30, H1 all up or all down)
BLOCK_AGAINST_HTF=true
# ช่วงเวลาที่อนุญาตให้เทรด (UTC) รูปแบบ HH:MM-HH:MM
TRADING_HOURS_UTC=01:00-20:00
# ช่วงงดเทรดช่วงข่าว (ใส่เอง ระบบไม่มี news feed) รูปแบบ ISO_UTC/นาที คั่นด้วย ,
# เช่น 2026-12-04T13:30Z/45,2026-12-10T19:00Z/60
NEWS_BLACKOUTS=
KILL_SWITCH_FILE=STOP

# ---------- Claude ----------
# api         = Claude API (ต้องมี ANTHROPIC_API_KEY + เครดิต)
# claude-code = เรียก Claude Code CLI ใช้โควตาแพ็กเกจ Claude ที่ login ไว้ ไม่ใช้เครดิต API
LLM_BACKEND=claude-code
CLAUDE_CODE_BIN=claude
# เว้นว่าง = โมเดลตั้งต้นของ Claude Code; sonnet/haiku ประหยัดโควตากว่า opus
CLAUDE_CODE_MODEL=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low
# default = เปิด server-side refusal fallback, off = ปิด
CLAUDE_FALLBACKS=default
# summarized = เก็บสรุปเหตุผลของโมเดลลง log (ใช้ดูย้อนหลัง/เทรน), omitted = ไม่เก็บ
CLAUDE_THINKING_DISPLAY=summarized

# ---------- Log / Label ----------
LOG_DIR=logs
# ช่วงเวลาที่วัดราคาหลังการตัดสินใจทุกรอบ (นาที)
LABEL_HORIZONS_MIN=15,60
# จำลองว่า SL/TP โดนอะไรก่อน ภายในกี่นาที
SIM_MAX_MINUTES=240

# ---------- อื่นๆ ----------
JOURNAL_DB=journal.sqlite
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# second opinion on every order before it is sent (empty = off); fail-closed by default
ORDER_REVIEW_MODEL=opus
ORDER_REVIEW_TIMEOUT=90
ORDER_REVIEW_FAIL_OPEN=false
# H4 Donchian 20/10 swing bot (python -m xau_agent.swing_bot), separate magic and process.
# At ~$9k equity the broker minimum 0.01 lot with a 2x H4 ATR stop already risks ~1%, so 0.5% would skip trades.
SWING_MAGIC=260513
SWING_RISK_PCT=1.0
SWING_MAX_LOT=0.05
SWING_MAX_SPREAD_POINTS=150
SWING_MAX_ENTRY_DELAY_MIN=30
# economic calendar (ForexFactory weekly JSON, unofficial); blocks entries around high-impact USD events.
# If the calendar is unavailable/stale, blocks the usual 08:30 and 10:00 New York release slots instead.
NEWS_AUTO=true
NEWS_BLOCK_BEFORE_MIN=15
NEWS_BLOCK_AFTER_MIN=15
